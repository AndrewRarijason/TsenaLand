# Copiez ce fichier en .env.local (en local) et renseignez les mêmes variables dans Vercel.
# Les valeurs se trouvent dans Supabase > Project Settings > API Keys (et Data API pour l'URL).

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique : « Publishable key » (sb_publishable_...) ou, à défaut, l'ancienne clé « anon »
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clé secrète : « Secret key » (sb_secret_...) ou, à défaut, l'ancienne clé « service_role »
# Ne JAMAIS la publier ni la préfixer par NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
